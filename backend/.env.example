FRONTEND_ORIGINS=http://localhost:5173,https://your-netlify-site.netlify.app

SECRET_KEY=replace-with-a-strong-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

